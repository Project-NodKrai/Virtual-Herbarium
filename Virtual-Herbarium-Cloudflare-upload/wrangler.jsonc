{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virtual-herbarium-test",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "HERBARIUM_BUCKET",
      "bucket_name": "virtual-herbarium"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OTP_STATE",
      "id": "283f2bcd518b46d88adbfd965477c6bb"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://data-herbarium.columbina.kr",
    "TOTP_STORE_KEY": "virtual-herbarium:totp-store:v1",
    "TOTP_STORE_ALLOW_BOOTSTRAP": "false",
    "LOGO_OBJECT_KEY": "virtual-herbarium/UI/logo.svg"
  }
}
