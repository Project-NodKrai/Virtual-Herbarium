{
  "entities": {
    "HerbariumRecord": {
      "title": "HerbariumRecord",
      "description": "Botanical specimen record in the virtual herbarium",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the specimen"
        },
        "type": {
          "type": "string",
          "maxLength": 100,
          "description": "Specimen type category"
        },
        "scientificName": {
          "type": "string",
          "maxLength": 200,
          "description": "Scientific Latin name"
        },
        "koreanName": {
          "type": "string",
          "maxLength": 200,
          "description": "Common Korean botanical name"
        },
        "kingdom": {
          "type": "string",
          "maxLength": 100,
          "description": "Biological kingdom"
        },
        "divisionPhylum": {
          "type": "string",
          "maxLength": 100,
          "description": "Division or Phylum"
        },
        "taxonomicClass": {
          "type": "string",
          "maxLength": 100,
          "description": "Taxonomic class"
        },
        "order": {
          "type": "string",
          "maxLength": 100,
          "description": "Taxonomic order"
        },
        "family": {
          "type": "string",
          "maxLength": 100,
          "description": "Botanical family"
        },
        "genus": {
          "type": "string",
          "maxLength": 100,
          "description": "Botanical genus"
        },
        "collector": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the specimen collector"
        },
        "collDate": {
          "type": "string",
          "maxLength": 100,
          "description": "Collection date"
        },
        "collectionNo": {
          "type": "string",
          "maxLength": 100,
          "description": "Collector field number"
        },
        "detBy": {
          "type": "string",
          "maxLength": 100,
          "description": "Identified by taxonomist"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "General collection location"
        },
        "specificLocality": {
          "type": "string",
          "maxLength": 500,
          "description": "Detailed collection site description"
        },
        "habitatInformation": {
          "type": "string",
          "maxLength": 1000,
          "description": "Habitat notes"
        },
        "latitude": {
          "type": "string",
          "maxLength": 100,
          "description": "Latitude coordinates"
        },
        "longitude": {
          "type": "string",
          "maxLength": 100,
          "description": "Longitude coordinates"
        },
        "altitudeDepth": {
          "type": "string",
          "maxLength": 100,
          "description": "Altitude or depth in meters"
        },
        "specimenName": {
          "type": "string",
          "maxLength": 200,
          "description": "Specimen common name"
        },
        "specimenNote": {
          "type": "string",
          "maxLength": 5000,
          "description": "Comprehensive specimen notes"
        },
        "image": {
          "type": "string",
          "maxLength": 500000,
          "description": "Image URL or data URI"
        }
      },
      "required": [
        "id",
        "type",
        "scientificName",
        "koreanName",
        "family",
        "genus",
        "collector",
        "collDate",
        "collectionNo"
      ]
    }
  },
  "firestore": {
    "/records/{recordId}": {
      "schema": "HerbariumRecord",
      "description": "Collection of botanical herbarium records"
    }
  }
}
